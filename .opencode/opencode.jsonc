    "ci-build-engineer": {
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.env*": "deny", "**/.ssh/**": "deny", "**/auth.json": "deny", "**/.beads/**": "deny" },
        "glob": "allow",
        "grep": "allow",
        "edit": {
          "*": "deny",
          ".github/workflows/**": "allow",
          "scripts/**": "allow",
          "assets/**": "allow",
          "configs/**": "allow",
          "tests/tooling/**": "allow",
          "package.json": "allow",
          "package-lock.json": "allow",
          "tsconfig.json": "allow",
          ".vscodeignore": "allow",
          ".gitignore": "allow",
          ".opencode/plugins/**": "allow",
          ".opencode/opencode-tooling.config.json": "allow",
          "docs/development/github-worktree-merge.md": "allow",
          "docs/development/tooling-provenance.md": "allow",
          "THIRD_PARTY_NOTICES.md": "allow",
          "LICENSES/**": "allow",
          "CONTRIBUTING.md": "allow",
          "TESTING.md": "allow",
          "RELEASING.md": "allow",
          "terminal/package.json": "allow",
          "terminal/package-lock.json": "allow",
          "terminal/scripts/**": "allow",
          "terminal/tsconfig.json": "allow",
          "terminal/.eslintrc.cjs": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "**/.env*": "deny"
        },
        "task": "deny",
        "skill": { "*": "deny", "worktree-merge": "allow" },
        "external_directory": { "*": "ask", "$HOME/.plannotator/plans/**": "allow" },
        "bash": {
          "*": "ask",
          "git --no-optional-locks -c core.fsmonitor=false status": "allow",
          "git --no-optional-locks -c core.fsmonitor=false status *": "allow",
          "git diff --no-ext-diff --no-textconv": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv": "allow",
          "git diff --no-ext-diff --no-textconv --cached": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv --cached": "allow",
          "git diff --no-ext-diff --no-textconv --stat": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv --stat": "allow",
          "git diff --no-ext-diff --no-textconv --cached | grep -E '^\\+.*(#|//|/\\*)'": "ask",
          "grep -E '^\\+.*(#|//|/\\*)'": "ask",
          "git log --oneline -10": "allow",
          "git --no-optional-locks -c core.fsmonitor=false log --oneline -10": "allow",
          "git worktree list --porcelain": "allow",
          "git --no-optional-locks -c core.fsmonitor=false worktree list --porcelain": "allow",
          "git rev-parse *": "allow",
          "git --no-optional-locks -c core.fsmonitor=false rev-parse *": "allow",
          "git branch --show-current": "allow",
          "git --no-optional-locks -c core.fsmonitor=false branch --show-current": "allow",
          "node --version": "allow",
          "python3 --version": "allow",
          "npm run lint": "ask",
          "npm run compile": "ask",
          "npm run verify": "ask",
          "npm test": "ask",
          "npm run test:tooling": "ask",
          "npm run test:tooling:python": "ask",
          "node --test tests/tooling/*": "ask",
          "python3 -m unittest discover *": "ask",
          "./node_modules/.bin/vsce ls --no-dependencies": "ask",
          "git add -- *": "ask",
          "*agent-wt-merge*": "ask",
