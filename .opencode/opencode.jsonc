{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions/development-lifecycle.md"
  ],
  "plugin": [
    ["@plannotator/opencode@{env:PLANNOTATOR_PIN_VERSION}", {
      "workflow": "user-managed",
      "runtime": "cli",
      "planningAgents": [
        "plan",
        "plan-GPT-xhigh",
        "special-builder",
        "agent-engineer"
      ]
    }]
  ],
  "permission": {
    "read": "deny",
    "external_directory": "deny",
    "bash": "deny",
    "edit": "deny",
    "doom_loop": "deny",
    "*": "deny"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "hidden": false,
      "options": { "reasoningEffort": "high" },
      "permission": {
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.env*": "deny", "**/.ssh/**": "deny", "**/auth.json": "deny", "**/.beads/**": "deny" },
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "external_directory": { "*": "deny", "$HOME/.plannotator/plans/**": "allow" },
        "bash": {
          "*": "deny",
          "git log --oneline --decorate --reverse *": "ask",
          "git --no-optional-locks -c core.fsmonitor=false log --oneline --decorate --reverse *": "ask",
          "git diff --no-ext-diff --no-textconv --stat *": "ask",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv --stat *": "ask",
          "git diff --no-ext-diff --no-textconv --name-status *": "ask",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv --name-status *": "ask",
          "git diff --no-ext-diff --no-textconv *": "ask",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv *": "ask",
          "git show --no-ext-diff --no-textconv *": "ask",
          "git --no-optional-locks -c core.fsmonitor=false show --no-ext-diff --no-textconv *": "ask",
          "git rev-parse *": "allow",
          "git --no-optional-locks -c core.fsmonitor=false rev-parse *": "allow",
          "git branch --show-current": "allow",
          "git --no-optional-locks -c core.fsmonitor=false branch --show-current": "allow",
          "git --no-optional-locks -c core.fsmonitor=false status": "allow",
          "git --no-optional-locks -c core.fsmonitor=false status *": "allow",
          "git diff --no-ext-diff --no-textconv": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv": "allow",
          "git diff --no-ext-diff --no-textconv --cached": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv --cached": "allow",
          "git log --oneline -10": "allow",
          "git --no-optional-locks -c core.fsmonitor=false log --oneline -10": "allow",
          "git commit *": "deny",
          "git * commit *": "deny",
          "command git commit *": "deny",
          "command git * commit *": "deny",
          "git push *": "deny",
          "git * push *": "deny",
          "command git push *": "deny",
          "command git * push *": "deny",
