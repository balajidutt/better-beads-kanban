{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    ".opencode/instructions/development-lifecycle.md"
  ],
  "plugin": [
    ["@plannotator/opencode@{file:~/.config/dotfiles/versions/plannotator}", {
      "workflow": "user-managed",
      "runtime": "cli",
      "planningAgents": [
        "plan",
        "plan-GPT-xhigh",
        "special-builder",
        "agent-engineer"
      ]
    }]
  ],
  "permission": {
    "read": "deny",
    "external_directory": "deny",
    "bash": "deny",
    "edit": "deny",
    "doom_loop": "deny",
    "*": "deny"
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "hidden": false,
      "options": { "reasoningEffort": "high" },
      "permission": {
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.env*": "deny", "**/.ssh/**": "deny", "**/auth.json": "deny", "**/.beads/**": "deny" },
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "external_directory": { "*": "deny", "$HOME/.plannotator/plans/**": "allow" },
        "bash": {
          "*": "deny",
          "git rev-parse *": "allow",
          "git --no-optional-locks -c core.fsmonitor=false rev-parse *": "allow",
          "git branch --show-current": "allow",
          "git --no-optional-locks -c core.fsmonitor=false branch --show-current": "allow",
          "git --no-optional-locks -c core.fsmonitor=false status": "allow",
          "git --no-optional-locks -c core.fsmonitor=false status *": "allow",
          "git diff --no-ext-diff --no-textconv": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv": "allow",
          "git diff --no-ext-diff --no-textconv --cached": "allow",
          "git --no-optional-locks -c core.fsmonitor=false diff --no-ext-diff --no-textconv --cached": "allow",
          "git log --oneline -10": "allow",
          "git --no-optional-locks -c core.fsmonitor=false log --oneline -10": "allow",
          "command bd --help": "allow",
          "command bd show --help": "allow",
          "command bd ready --help": "allow",
          "command bd list --help": "allow",
          "command bd -C * --readonly show *": "ask",
          "command bd -C * --readonly ready *": "ask",
          "command bd -C * --readonly list *": "ask",
          "*>*": "deny"
        },
        "task": { "*": "deny", "plan-reviewer": "allow", "test-strategist": "allow", "code-reviewer": "allow" },
        "skill": "deny",
        "question": "allow",
        "submit_plan": "allow",
        "webfetch": "deny",
        "websearch_cited": "deny",
        "codesearch": "deny",
        "doom_loop": "deny"
      }
    },
    "build": {
      "mode": "primary",
      "hidden": false,
      "permission": {
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.env*": "deny", "**/.ssh/**": "deny", "**/auth.json": "deny", "**/.beads/**": "deny" },
        "glob": "allow",
        "grep": "allow",
        "edit": "deny",
        "bash": "deny",
        "external_directory": {
          "*": "deny",
          "$HOME/.plannotator/plans/**": "allow"
        },
        "task": {
          "*": "deny",
          "plan-reviewer": "allow",
          "beads-manager": "allow",
          "code-reviewer": "allow",
          "typescript-specialist": "allow",
          "webview-specialist": "allow",
          "test-strategist": "allow",
          "ci-build-engineer": "allow",
          "release-manager": "allow"
        },
        "skill": { "*": "deny", "unslop-commit": "allow" },
        "question": "allow",
        "submit_plan": "deny",
        "webfetch": "deny",
        "websearch_cited": "deny",
        "codesearch": "deny",
        "doom_loop": "deny"
      }
    },
    "plan-reviewer": {
      "model": "anthropic/claude-opus-5",
      "variant": "high",
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.env*": "deny", "**/.ssh/**": "deny", "**/auth.json": "deny", "**/.beads/**": "deny" },
        "glob": "allow",
        "grep": "allow",
        "bash": {
