    "release-manager": {
      "model": "openai/gpt-6.1-sol",
      "variant": "high",
      "permission": {
        "*": "deny",
        "read": { "*": "allow", "*.env": "deny", "*.env.*": "deny", "**/.env*": "deny", "**/.ssh/**": "deny", "**/auth.json": "deny", "**/.beads/**": "deny" },
        "glob": "allow",
        "grep": "allow",
        "edit": { "*": "deny", "CHANGELOG.md": "allow", "package.json": "allow", "package-lock.json": "allow", "src/webview.ts": "allow", "RELEASING.md": "allow" },
        "task": "deny",
        "skill": "deny",
        "external_directory": { "*": "ask", "$HOME/.plannotator/plans/**": "allow" },
        "bash": {
          "*": "ask",
          "git log --oneline --decorate --reverse *": "ask",
          "git --no-optional-locks -c core.fsmonitor=false log --oneline --decorate --reverse *": "ask",
